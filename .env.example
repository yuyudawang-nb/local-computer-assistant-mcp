# Copy values into YOUR shell environment, not into Git.
LOCAL_RESEARCH_ROOT=/path/to/your/project
LOCAL_RESEARCH_ALLOW_EXEC=0
LOCAL_RESEARCH_ALLOW_DESKTOP=0
# Linux X11 desktop only:
# DISPLAY=:0
# Optional official tunnel-client path:
# TUNNEL_CLIENT=/absolute/path/to/tunnel-client
# Optional personal HTTP proxy:
# HTTPS_PROXY=http://127.0.0.1:port
